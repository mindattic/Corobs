{
  "name": "@mindattic/corobs",
  "version": "0.1.0",
  "description": "COROBS: Correlithm Object technology as a pure, deterministic library. Unit N-cube statistics, correlithm objects (soft tokens), string COs, converters, pattern and rule mining, cueing and benchmarking. Bit-for-bit identical to the C# reference under the same seed.",
  "keywords": [
    "mindattic",
    "corobs",
    "correlithm",
    "high-dimensional",
    "similarity",
    "anomaly"
  ],
  "license": "UNLICENSED",
  "author": "MindAttic",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./seeding": {
      "types": "./dist/seeding.d.ts",
      "import": "./dist/seeding.js"
    },
    "./strings": {
      "types": "./dist/strings.d.ts",
      "import": "./dist/strings.js"
    },
    "./converters": {
      "types": "./dist/converters.d.ts",
      "import": "./dist/converters.js"
    },
    "./mining": {
      "types": "./dist/mining.d.ts",
      "import": "./dist/mining.js"
    },
    "./bench": {
      "types": "./dist/bench.d.ts",
      "import": "./dist/bench.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
